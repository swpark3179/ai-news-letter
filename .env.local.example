# =============================================================================
# AI 뉴스레터 — 환경변수
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. .env.local 은 커밋되지 않습니다.
# =============================================================================

# --- Supabase (서버 전용) ----------------------------------------------------
# Supabase 대시보드 > Project Settings > API 에서 확인
# Project URL 만 넣으세요. REST 엔드포인트(.../rest/v1/) 가 아닙니다.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# 발표 자료·사진을 올릴 Storage 버킷 이름
SUPABASE_STORAGE_BUCKET=newsletter

# --- 세션 --------------------------------------------------------------------
# 32바이트 이상 임의 문자열. 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- 사내 SSO ----------------------------------------------------------------
# mock : 트레이 모듈 없이 로그인 화면 전체를 시뮬레이션 (기본)
# real : 실제 WebSocket 연동 — src/lib/auth/sso/{client,decode}.ts 를 채운 뒤 사용
NEXT_PUBLIC_SSO_MODE=mock
NEXT_PUBLIC_SSO_TRAY_WS_URL=
# real 모드에서 서버가 페이로드를 복호화할 때 쓰는 키
SSO_DECODE_KEY=

# --- LLM ---------------------------------------------------------------------
# 트렌드 브리핑 기사 작성에만 쓰입니다. 긱뉴스 동기화는 LLM 을 쓰지 않습니다.
# gemini | openai — 비워 두면 키가 등록된 쪽을 자동으로 씁니다(둘 다면 openai).
# 정기 실행(GitHub Actions)은 sync-trend-openai.yml 이 openai 로 고정합니다.
LLM_PROVIDER=openai

# Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# 호출 간 최소 간격(ms). 기본값은 openai 500 / gemini 7000 (무료 티어 10 RPM).
# LLM_MIN_CALL_INTERVAL_MS=7000

# --- 수집 스크립트 -----------------------------------------------------------
# 긱뉴스에서 며칠 전까지 긁어올지
GEEK_LOOKBACK_DAYS=3
GEEK_MAX_PAGES=8
# 트렌드 브리핑 1회 실행당 새로 기사화할 최대 건수 (할당량·비용 보호)
# 이 상한은 출처(github/hn/arxiv)별로 번갈아 나눠 담습니다.
TREND_MAX_NEW=30
# Hacker News 선별 기준 점수
HN_MIN_SCORE=150
# GitHub API 레이트리밋 완화용 (선택) — public repo 읽기 권한이면 충분
GITHUB_TOKEN=
