# =============================================================================
# AI 뉴스레터 — 환경변수
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. .env.local 은 커밋되지 않습니다.
# =============================================================================

# --- Supabase (서버 전용) ----------------------------------------------------
# Supabase 대시보드 > Project Settings > API 에서 확인
# Project URL 만 넣으세요. REST 엔드포인트(.../rest/v1/) 가 아닙니다.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# 발표 자료·사진을 올릴 Storage 버킷 이름
SUPABASE_STORAGE_BUCKET=newsletter

# --- 세션 --------------------------------------------------------------------
# 32바이트 이상 임의 문자열. 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 모바일 앱의 액세스 토큰도 이 값으로 서명합니다 (웹 세션과 같은 JWT).
# 바꾸면 웹·앱의 모든 세션이 함께 끊깁니다.
SESSION_SECRET=

# --- 사내 SSO ----------------------------------------------------------------
# mock : 트레이 모듈 없이 로그인 화면 전체를 시뮬레이션 (기본)
# real : 실제 Knox 트레이 연동 (getknoxsso)
NEXT_PUBLIC_SSO_MODE=mock

# 트레이 모듈의 로컬 WebSocket 주소. 레거시 참고값: wss://localhost:29283
#   · ws:// 가 아니라 wss:// 를 씁니다 — https 페이지에서 ws:// 는 혼합 콘텐츠로 막힙니다.
#   · 인증서가 신뢰되지 않으면 브라우저에서 「모듈 미실행」과 구분되지 않습니다.
#   · localhost 와 127.0.0.1 은 인증서 SAN 에 따라 다릅니다. 받은 값 그대로 넣으세요.
# 비워 두면 로그인 화면이 SSO_CONFIG_MISSING 안내를 띄웁니다 (기본값을 두지 않습니다).
NEXT_PUBLIC_SSO_TRAY_WS_URL=

# getknoxsso 요청의 data 필드 — 트레이가 애플리케이션을 구분하는 코드.
# 레거시 교육포털은 KCC60TRAY0109 를 썼습니다. **그 값을 그대로 쓰지 마세요** —
# 이 서비스용 코드를 별도로 발급받아 넣습니다 (docs/SSO_KNOX_PROTOCOL.md).
NEXT_PUBLIC_SSO_TRAY_APP_CODE=

# 페이로드 복호화 키 (SecuBase 의 SSO baseKey, 32바이트).
# Java 소스의 8진 이스케이프("\47\10\167…")와 base64 를 모두 받습니다.
# .env 에는 제어문자를 담을 수 없으므로 **base64 로 넣는 것을 권합니다.**
SSO_DECODE_KEY=

# 처음 보는 EPID 를 자동 가입시킬지. 비워 두면 mock=true / real=false.
# 방침은 「등록된 members 만 로그인한다」입니다 — 미등록은 403 SSO_NOT_REGISTERED.
SSO_ALLOW_AUTO_CREATE=

# ⚠ SecuBase 규격을 받기 전까지의 안전장치.
# 지금 decode-knox.ts 는 「단순 인코딩」을 가정하고 있어 **페이로드 위조를 막지 못합니다.**
# 그래서 운영 빌드에서 real 모드는 이 값이 1 일 때만 세션을 발급합니다.
# 개발·스테이징(NODE_ENV != production)에서는 값과 무관하게 열려 있습니다.
# SSO_ALLOW_UNVERIFIED_PAYLOAD=1

# 목업 전용 우회 경로(사번+비밀번호 폴백 · 게스트 열람 · 무로그인 자동 세션)는
# NEXT_PUBLIC_SSO_MODE=mock 이고 **운영 빌드가 아닐 때만** 열립니다.
# 최종 방침은 「사내 SSO 를 통과하지 못하면 일반 사용을 제공하지 않는다」입니다.
# 켜는 스위치는 없습니다 — src/lib/env.ts 의 devAuthEnv 참고.

# --- 모바일 앱 소셜 로그인 (앱을 붙일 때만) ---------------------------------
# 모바일은 사내 SSO 를 쓸 수 없어(트레이 모듈이 PC 전용) Google · Apple 의
# ID 토큰을 서버가 검증합니다. 자세한 내용은 docs/MOBILE_OAUTH2.md.
# 아래 값이 비어 있으면 해당 엔드포인트만 500 이고 웹은 영향을 받지 않습니다.

# ID 토큰의 aud 로 허용할 값. 앱의 GOOGLE_SERVER_CLIENT_ID 와 같아야 합니다.
GOOGLE_WEB_CLIENT_ID=
# 설정이 어긋난 빌드 대비 (선택). 운영이 안정되면 위 하나만 남기는 편이 안전합니다.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# 허용할 Workspace 도메인(hd 클레임). 쉼표 구분.
# **비우면 도메인 제한 없음** — 현재 방침입니다. Google 에만 걸립니다.
ALLOWED_HOSTED_DOMAINS=

# Apple ID 토큰의 aud. 쉼표 구분.
#   iOS 네이티브 = 번들 ID / Android 웹 = Services ID
APPLE_CLIENT_IDS=
# Apple 콜백이 되돌릴 앱. Android 의 applicationId 와 같아야 합니다.
APPLE_ANDROID_PACKAGE=io.github.swpark3179.ainewsletter

# --- LLM ---------------------------------------------------------------------
# 트렌드 브리핑 기사 작성에만 쓰입니다. 긱뉴스 동기화는 LLM 을 쓰지 않습니다.
# gemini | openai — 비워 두면 키가 등록된 쪽을 자동으로 씁니다(둘 다면 openai).
# 정기 실행(GitHub Actions)은 sync-trend-openai.yml 이 openai 로 고정합니다.
LLM_PROVIDER=openai

# Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# 호출 간 최소 간격(ms). 기본값은 openai 500 / gemini 7000 (무료 티어 10 RPM).
# LLM_MIN_CALL_INTERVAL_MS=7000

# --- 수집 스크립트 -----------------------------------------------------------
# 긱뉴스에서 며칠 전까지 긁어올지
GEEK_LOOKBACK_DAYS=3
GEEK_MAX_PAGES=8
# 트렌드 브리핑 1회 실행당 새로 기사화할 최대 건수 (할당량·비용 보호)
# 이 상한은 출처(github/hn/arxiv)별로 번갈아 나눠 담습니다.
TREND_MAX_NEW=30
# Hacker News 선별 기준 점수
HN_MIN_SCORE=150
# GitHub API 레이트리밋 완화용 (선택) — public repo 읽기 권한이면 충분
GITHUB_TOKEN=
